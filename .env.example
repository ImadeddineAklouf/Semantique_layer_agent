GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Application
APP_NAME=semantic-layer-builder
APP_VERSION=0.1.0
APP_ENV=development

# Agents
AGENT_MODEL=gemini-flash-latest

# Logging
LOG_LEVEL=INFO
LOG_FILE_NAME=semantic_layer_builder.log

# Google Gemini / ADK
# Ne renseigner une vraie valeur que dans le fichier .env local.
GOOGLE_API_KEY=replace_with_your_api_key